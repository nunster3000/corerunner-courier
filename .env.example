# Portfolio default: no AI requests or credentials needed.
COREY_MODE=mock
# Future owner only: set COREY_MODE=live to enable the optional adapter.
# Server only. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional public portfolio deployment on Vercel. Local npm run dev ignores these.
# Connect Neon through Vercel Marketplace; all values below are server-only.
# Never commit actual values or give these variables a VITE_ prefix.
APP_MODE=
DATABASE_URL=
APP_ORIGIN=
DEMO_SESSION_SECRET=
